{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ui-kit": {
      "projectType": "library",
      "root": "projects/ui-kit",
      "sourceRoot": "projects/ui-kit/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ui-kit/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui-kit/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ui-kit/tsconfig.spec.json"
          }
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": "projects/ui-kit/.storybook",
            "port": 6006,
            "tsConfig": "projects/ui-kit/.storybook/tsconfig.json",
            "zoneless": false,
            "stylePreprocessorOptions": {
              "includePaths": ["projects/ui-kit/src/lib"]
            }
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": "projects/ui-kit/.storybook",
            "outputDir": "storybook-static/ui-kit",
            "tsConfig": "projects/ui-kit/.storybook/tsconfig.json",
            "zoneless": false,
            "stylePreprocessorOptions": {
              "includePaths": ["projects/ui-kit/src/lib"]
            }
          }
        }
      }
    }
  }
}
