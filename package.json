{
  "name": "bepower-ui-kit",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "tsc --project projects/ui-kit/tsconfig.spec.json --noEmit",
    "storybook": "ng run ui-kit:storybook",
    "storybook:build": "ng run ui-kit:build-storybook",
    "icons:import": "node ./scripts/import-icons.mjs",
    "publish": "npm publish ./dist/ui-kit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BePower/ui-kit.git"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/screen-reader": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/angular": "^8.8.13",
    "@ionic/core": "^8.8.13",
    "i": "^0.3.7",
    "npm": "^11.18.0",
    "rxjs": "~7.8.0",
    "source-sans": "^3.52.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.1",
    "@angular-devkit/build-angular": "21.2.18",
    "@angular/animations": "21.2.17",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/localize": "21.2.17",
    "@angular/platform-server": "21.2.17",
    "@angular/service-worker": "21.2.17",
    "@angular/ssr": "21.2.18",
    "@compodoc/compodoc": "1.1.26",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/angular-vite": "10.5.10",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.0.0",
    "prettier": "^3.8.1",
    "storybook": "10.5.10",
    "typescript": ">=5.9.0 <6.0.0",
    "vite": "8.2.2",
    "vitest": "4.1.9"
  }
}
